    <Folder Include="Areas\Auth\Views\" />
    <Folder Include="Areas\Customer\Controllers\" />
    <Folder Include="Areas\Customer\Data\" />
    <Folder Include="Areas\Customer\Models\" />
    <Folder Include="Areas\Customer\Views\" />
    <Folder Include="Areas\Inventory\Controllers\" />
    <Folder Include="Areas\Inventory\Data\" />
    <Folder Include="Areas\Inventory\Models\" />
    <Folder Include="Areas\Inventory\Views\" />
    <Folder Include="Areas\Kitchen\Controllers\" />
    <Folder Include="Areas\Kitchen\Data\" />
    <Folder Include="Areas\Kitchen\Models\" />
    <Folder Include="Areas\Kitchen\Views\" />
  </ItemGroup>

</Project>
